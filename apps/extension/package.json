{
  "name": "extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Personal API browser extension (Firefox + Edge/Chromium) (WXT, MV3).",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build && wxt build -b firefox --mv3",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "zip:chrome": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "pnpm build && vitest run"
  },
  "dependencies": {
    "@personal-api/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "wxt": "0.21.4"
  }
}

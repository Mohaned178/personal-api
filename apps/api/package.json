{
  "name": "@personal-api/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API for Personal API.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "nestjs-pino": "5.2.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@personal-api/tsconfig": "workspace:*",
    "@nestjs/testing": "11.2.6",
    "@swc/core": "1.16.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
}

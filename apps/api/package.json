{
  "name": "@personal-api/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API for Personal API.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.mts",
    "db:generate": "node --env-file-if-exists=../../.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=../../.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "worker": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/worker.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@personal-api/contracts": "workspace:*",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "nestjs-pino": "5.2.1",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.6",
    "@personal-api/tsconfig": "workspace:*",
    "@swc/core": "1.16.2",
    "@testcontainers/postgresql": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
}

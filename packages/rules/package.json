{
  "name": "@personal-api/rules",
  "version": "1.0.0",
  "private": true,
  "description": "The pure rule engine, shared by the extension and the API. No Node, DOM or I/O.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && node scripts/mark-cjs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@personal-api/contracts": "workspace:*"
  },
  "devDependencies": {
    "@personal-api/tsconfig": "workspace:*",
    "@types/node": "24.19.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}

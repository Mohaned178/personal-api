{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.output",
      "!**/.wxt",
      "!**/.turbo",
      "!**/coverage",
      "!**/drizzle/meta"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/api/**"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      },
      "javascript": {
        "parser": {
          "unsafeParameterDecoratorsEnabled": true
        }
      }
    },
    {
      "includes": [
        "packages/contracts/src/rule*.ts",
        "packages/contracts/src/ingest-config.spec.ts",
        "apps/extension/test/rules/**",
        "packages/rules/src/**",
        "apps/web/src/lib/rule-draft.ts",
        "apps/web/src/lib/rule-draft.spec.ts",
        "apps/web/src/lib/rule-templates.ts",
        "apps/web/src/lib/explain.spec.ts",
        "apps/web/src/routes/events.spec.tsx",
        "apps/web/src/routes/rules-page.tsx",
        "apps/web/src/routes/rules.spec.tsx",
        "apps/api/src/modules/rules/*.spec.ts",
        "apps/api/src/modules/ingest/ingest.service.spec.ts",
        "apps/api/src/modules/ingest/ingest-config.int.spec.ts",
        "apps/api/src/modules/ingest/ingest-rules.int.spec.ts",
        "apps/e2e/support/stack.ts",
        "apps/api/src/modules/integrations/cross-tenant-sweep.int.spec.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noThenProperty": "off"
          }
        }
      }
    }
  ]
}

{
  "name": "personal-api",
  "version": "1.0.0",
  "private": true,
  "description": "A self-hosted, multi-account personal data platform.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.28.2 <12"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "db:migrate": "pnpm --filter @personal-api/api db:migrate",
    "db:generate": "pnpm --filter @personal-api/api db:generate",
    "test:int": "turbo run test:int",
    "worker": "pnpm --filter @personal-api/api worker",
    "test:e2e": "turbo run test:e2e",
    "e2e:install": "pnpm --filter @personal-api/e2e e2e:install",
    "licenses:check": "node scripts/license-check.mjs",
    "audit:prod": "pnpm audit --prod"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "turbo": "2.11.5",
    "typescript": "6.0.3"
  }
}

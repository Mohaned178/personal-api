# Copy to .env (gitignored). Dev-only values; no real secrets belong here.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=personal_api

# Host port 5433 (compose). Never point this at port 5432.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/personal_api

# Dashboard auth (Better Auth). The secret signs session cookies: generate one with
# `openssl rand -base64 32` (at least 32 characters). Left empty on purpose so the API refuses
# to start until you set it.
BETTER_AUTH_SECRET=
# Public origin of the API + dashboard. Use https:// in production so cookies are Secure.
# With the Vite dev server (`pnpm --filter web dev`) use http://localhost:5173, or the CSRF check
# refuses dashboard mutations.
BETTER_AUTH_URL=http://localhost:3000
# "true" or "false" only. With false, only the first account can sign up.
ALLOW_SIGNUP=false

# How many reverse proxies sit in front of the API (default 0 = none). Behind Caddy or nginx set 1,
# so rate limits count each client address instead of the proxy. Too high lets clients fake theirs.
# TRUST_PROXY=0

# Where export files are written (optional, default ./data/exports from the working directory).
# The API and the worker must share this directory.
# EXPORT_DIR=

# Production only (docker-compose.prod.yml): the public domain Caddy serves and gets a certificate
# for. Copy this file to .env.production and set the secrets there, with BETTER_AUTH_URL=https://<domain>.
# PA_DOMAIN=pa.example.com
